# Financial Mind-Map OS — environment configuration
# Copy to `.env` and adjust. All values are optional; sensible defaults apply.

# --- Storage ---------------------------------------------------------------
# Path to the local SQLite database file.
FMM_DB_PATH=financial_os.db

# --- Privacy ---------------------------------------------------------------
# Salt used to hash PII before storage. CHANGE THIS to a long random value.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
PII_SALT=change_me_to_a_long_random_value

# --- Sync engine -----------------------------------------------------------
# How often the heartbeat runs, in hours.
FMM_HEARTBEAT_HOURS=4

# --- Subscription Killer heuristic ----------------------------------------
# Minimum number of charges from the same merchant to call it recurring.
FMM_SUB_MIN_OCCURRENCES=3
# Allowed relative variation in charge amount (0.05 == +/-5%).
FMM_SUB_AMOUNT_TOLERANCE=0.05
# Allowed variation (in days) between charges vs. the expected cadence.
FMM_SUB_INTERVAL_TOLERANCE_DAYS=5

# --- Price-increase detection ----------------------------------------------
# Alert when a recurring charge steps up by at least
# max(MIN_ABS dollars, MIN_REL * old price).
FMM_SUB_PRICE_INCREASE_MIN_ABS=0.50
FMM_SUB_PRICE_INCREASE_MIN_REL=0.03
# Charges required at the new price before alerting (1 = first occurrence).
FMM_SUB_PRICE_MIN_NEW_CHARGES=1

# --- Market data / investments ----------------------------------------------
# Quote provider for marking holdings to market: auto | finnhub | alphavantage | none.
# 'auto' uses whichever API key is set below; with no key, prices stay at cost basis.
FMM_MARKET_DATA_PROVIDER=auto
# Free keys: https://finnhub.io (60 calls/min) or https://www.alphavantage.co (25/day).
FMM_FINNHUB_API_KEY=
FMM_ALPHAVANTAGE_API_KEY=
# A held symbol moving at least this % between syncs raises a portfolio alert.
FMM_PORTFOLIO_MOVE_ALERT_PCT=5

# --- Household vigilance ---------------------------------------------------
# Current-month spend above baseline * this factor is flagged as a spike.
FMM_HOUSEHOLD_SPIKE_FACTOR=1.5
